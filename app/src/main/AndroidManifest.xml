<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 允许应用在RK3566系统启动完成后接收开机广播 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 读取以太网/Wi-Fi等当前连接状态 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 迷你主机通过 WiFi 推送 X-Ray 图像（TCP 服务端监听与收发） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 当前MIPI摄像头、CameraX以及后续系统登记的UVC摄像头使用 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 小农助手语音输入：百度语音识别 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 历史记录读取影像缩略图 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Android 9及以下写 MediaStore 需要写权限（MainActivity 运行时请求）；Android 10+ 由 RELATIVE_PATH 免权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 11及以下蓝牙兼容权限 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12及以上：读取已配对设备并建立蓝牙连接 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 当前摄像头存在时使用；设为false避免某些固件阻止安装 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- 后续普通USB摄像头、USB热成像和USB毫米波雷达使用 -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- X-Ray通过蓝牙主机传输影像；没有蓝牙的调试设备仍允许安装 -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="微光智造"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeiguangDRController">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">

            <!-- 保留普通应用入口，便于调试和手动启动 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 把本软件声明为HOME候选；设为默认HOME后，开机直接进入本软件 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.HOME" />
            </intent-filter>

        </activity>


        <!-- 开机广播备用启动方式 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
