<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/thermalImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:contentDescription="热成像实时画面"
        android:scaleType="fitCenter" />

    <View
        android:id="@+id/thermalBlackMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <View
        android:layout_width="1dp"
        android:layout_height="70dp"
        android:layout_gravity="center"
        android:background="#80FFFFFF" />

    <View
        android:layout_width="70dp"
        android:layout_height="1dp"
        android:layout_gravity="center"
        android:background="#80FFFFFF" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_margin="10dp"
        android:background="@drawable/bg_card_tech"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/thermalStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
        android:text="● 热成像待连接"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/thermalDeviceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="等待设备连接"
            android:textColor="#9FB3C1"
            android:textSize="10sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/thermalCaptureButton"
            android:layout_width="118dp"
            android:layout_height="44dp"
            android:backgroundTint="#1976D2"
            android:enabled="false"
            android:minHeight="0dp"
            android:text="拍照"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/thermalControlButton"
            android:layout_width="145dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#1976D2"
            android:minHeight="0dp"
            android:text="启动热成像"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
