<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071018"
    android:orientation="horizontal">

    <!-- 左侧约 3/4：主要显示所选历史 X-Ray 图像 -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:background="#000000">

        <ImageView
            android:id="@+id/xrayImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:contentDescription="历史X-Ray影像显示区域"
            android:scaleType="fitCenter" />

        <View
            android:id="@+id/xrayBlackMask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <LinearLayout
            android:id="@+id/xrayCenterPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/xrayCenterHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="选择历史X-Ray影像"
                android:textColor="#9FB3C1"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/xrayHistoryButton"
                android:layout_width="190dp"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#1976D2"
                android:minHeight="0dp"
                android:text="选择查看X-Ray图"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_margin="10dp"
            android:background="@drawable/bg_card_tech"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/xrayStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● 历史X-Ray查看"
                android:textColor="#70D69B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/xrayCaptureTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="案例时间：--"
                android:textColor="#9FB3C1"
                android:textSize="9sp" />
        </LinearLayout>

        <Button
            android:id="@+id/xrayHistoryCornerButton"
            android:layout_width="132dp"
            android:layout_height="40dp"
            android:layout_gravity="start|bottom"
            android:layout_margin="10dp"
            android:backgroundTint="#263844"
            android:minHeight="0dp"
            android:text="返回选择界面"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>

    <Space
        android:layout_width="8dp"
        android:layout_height="match_parent" />

    <!-- 右侧约 1/4：AI 分析结果，内容过长时可上下滑动 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_card_tech"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI分析结果"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="选择历史X-Ray图像后显示该案例已保存的分析报告"
            android:textColor="#8296A5"
            android:textSize="10sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_tech"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/xrayAiResultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:lineSpacingExtra="4dp"
                android:text="请先点击左侧“选择查看X-Ray图”选择一个历史案例。"
                android:textColor="#D6E3EA"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
