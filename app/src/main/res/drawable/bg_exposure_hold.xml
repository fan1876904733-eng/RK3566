<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF8A00" android:endColor="#FFB800" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FFFFD36A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#007ACC" android:endColor="#00B4FF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#6600D8FF" />
        </shape>
    </item>
</selector>
