<?xml version="1.0" encoding="utf-8"?>
<!-- 可点击设备卡：默认同 bg_card_tech，按下时边框提亮、背景加亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#B0284068" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="#A000B4FF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#99142850" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="#8000B4FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80142850" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#330096FF" />
        </shape>
    </item>
</selector>
